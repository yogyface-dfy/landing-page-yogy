# Variables d'environnement — À configurer sur Railway (Settings → Variables)
# ⚠️ SANS préfixe VITE_ : ces valeurs restent côté serveur et ne sont JAMAIS
#    embarquées dans le bundle frontend.

AIRTABLE_PAT=pat_xxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxx
# Tunnel atelier (autre base que la liste d'attente)
AIRTABLE_ATELIER_BASE_ID=appSz9eVZWu6PoA2A
AIRTABLE_ATELIER_TABLE_ID=tblgeGEVgkZnDxwfR

# --- Stripe (Checkout Session + upsell 1 clic) ---
# Clé secrète : Stripe → Developers → API keys. JAMAIS de préfixe VITE_.
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# Webhook : Stripe → Developers → Webhooks → https://yogyface.fr/api/stripe/webhook
# Events : checkout.session.completed, invoice.paid
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Optionnel : surcharge l'upsell (sinon src/lib/stripe-offers.js)
# STRIPE_UPSELL_NAME=Séance individuelle avec Laury
# STRIPE_UPSELL_AMOUNT_CENTS=9700

# --- Analytics PostHog (côté client) ---
# La "Project API Key" PostHog est publique par nature (clé d'ingestion en
# écriture seule), donc le préfixe VITE_ est volontaire ici.
# À récupérer dans PostHog → Settings → Project → Project API Key.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- Meta Pixel + Conversions API (même pixel que webi) ---
# Pixel ID public (front hardcodé aussi). Token CAPI : serveur only.
META_PIXEL_ID=604268118937812
META_CAPI_TOKEN=EAAB...
META_GRAPH_VERSION=v21.0
# Vide en prod. En QA : Events Manager → Test Events → code TEST…
META_TEST_EVENT_CODE=

# Replay /replay-gratuit — short link (destination = URL YouTube de la semaine)
REPLAY_SHORT_URL=https://go.yogyface.fr/replay-yt

# App 7 jours (webi) — cookie identité + ping /vente
# Même secret que INSCRIPTION_WEBHOOK_SECRET côté webi.
WEBI_APP_URL=https://webi.yogyface.fr
INSCRIPTION_WEBHOOK_SECRET=change-me-long-random-secret
